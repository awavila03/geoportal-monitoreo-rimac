# Copiar a .env (no se versiona) y completar. Solo placeholders aquí.

# Conexión a PostGIS (variables estándar de libpq), siempre con el rol de solo lectura
PGHOST=db-spatial
PGPORT=5432
PGDATABASE=monitoreo_rimac
PGUSER=geoportal_ro
PGPASSWORD=CAMBIAR_POR_LA_CONTRASEÑA

# Mapa base (opcional). Vacío = CARTO Positron (rastertiles/light_all).
# Debe empezar por https:// y contener {z}, {x} e {y}.
MAPA_BASE_URL=
# CARTO exige key en basemaps.cartocdn.com; sin ella las teselas salen con la
# marca "API KEY REQUIRED". Se añade como ?key=... (o sustituye {api_key} si la
# URL lo contiene). OJO: llega al navegador vía /api/config, así que cualquier
# visitante puede verla: restríngela al dominio del geoportal en el panel de CARTO.
CARTO_API_KEY=

# Tamaño máximo del pool de conexiones (opcional)
POOL_MAX=5
