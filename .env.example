# Copiar a .env (no se versiona) y completar. Solo placeholders aquí.

# Conexión a PostGIS (variables estándar de libpq), siempre con el rol de solo lectura
PGHOST=db-spatial
PGPORT=5432
PGDATABASE=monitoreo_rimac
PGUSER=geoportal_ro
PGPASSWORD=CAMBIAR_POR_LA_CONTRASEÑA

# Mapa base (opcional). Vacío = CARTO Positron, que no requiere key.
# Debe empezar por https:// y contener {z}, {x} e {y}.
MAPA_BASE_URL=
# Opcional y vacía por defecto. Solo se usa si MAPA_BASE_URL contiene {api_key}.
# OJO: se envía al navegador vía /api/config, así que es pública para cualquier visitante.
CARTO_API_KEY=

# Tamaño máximo del pool de conexiones (opcional)
POOL_MAX=5
